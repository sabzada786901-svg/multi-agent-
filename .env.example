# ---- LLM (openrouter | groq) ----
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
# Free model id (must end in :free). Check https://openrouter.ai/models?max_price=0 if it stops working.
OPENROUTER_MODEL=openai/gpt-oss-120b:free

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Qdrant Cloud (free tier) ----
VECTOR_DB_URL=
VECTOR_DB_API_KEY=

# ---- GitHub MCP (fine-grained PAT) ----
GITHUB_TOKEN=

# ---- Google (Calendar + Gmail MCP servers) ----
# Absolute path to the OAuth "Desktop app" client JSON downloaded from Google Cloud Console
GOOGLE_OAUTH_CREDENTIALS=

TIMEZONE=Asia/Karachi

# ---- Optional tuning ----
# TOP_K=5
# MIN_RETRIEVAL_SCORE=0.25
